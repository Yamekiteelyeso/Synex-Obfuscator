# Copy these variables into your deployment environment. Never commit real secrets.
SYNEX_ADMIN_EMAIL=admin@example.com
SYNEX_ADMIN_PASSWORD=change-this-password
SYNEX_DATA_FILE=/data/synex-data.json

# Discord OAuth2 login (Discord Developer Portal > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/discord/callback
