# Copia estas variables a Railway. No subas secretos reales al repositorio.
SYNEX_DATA_FILE=/data/synex-data.json
# IDs de usuario de Discord autorizados como administradores, separados por comas.
SYNEX_ADMIN_DISCORD_IDS=

# Discord OAuth2: Client Secret (NO es el token de un bot).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-RAILWAY-DOMAIN/api/auth/discord/callback
